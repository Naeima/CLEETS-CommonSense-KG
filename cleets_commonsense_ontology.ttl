@prefix cleets: <https://w3id.org/def/cleets#> .
@prefix cleetscs: <https://w3id.org/def/cleets/commonsense/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

cleets:AdequateChargingProvision a owl:Class ;
    rdfs:label "Adequate charging provision"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf cleets:ChargingProvisionState .

cleets:HighSocialVulnerability a owl:Class ;
    rdfs:label "High social vulnerability"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf cleets:SocialVulnerabilityState .

cleets:LowEVAdoption a owl:Class ;
    rdfs:label "Low EV adoption"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf cleets:AdoptionState .

cleets:ModerateEVAdoption a owl:Class ;
    rdfs:label "Moderate EV adoption"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf cleets:AdoptionState .

cleets:atLocation a owl:ObjectProperty ;
    rdfs:label "at location"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:basedOn a owl:ObjectProperty ;
    rdfs:label "based on"@en ;
    rdfs:domain cleets:CommonsenseInference ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range cleets:Observation .

cleets:capableOf a owl:ObjectProperty ;
    rdfs:label "capable of"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:confidenceValue a owl:DatatypeProperty ;
    rdfs:label "confidence value"@en ;
    rdfs:domain cleets:CommonsenseInference ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range xsd:decimal .

cleets:externalConcept a owl:ObjectProperty ;
    rdfs:label "external concept"@en ;
    rdfs:domain cleets:SemanticAlignment ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range owl:Thing .

cleets:externalIdentifier a owl:DatatypeProperty ;
    rdfs:label "external identifier"@en ;
    rdfs:domain owl:Thing ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range xsd:string .

cleets:externalRelation a owl:DatatypeProperty ;
    rdfs:label "external relation"@en ;
    rdfs:domain rdf:Statement ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range xsd:string .

cleets:externalSource a owl:DatatypeProperty ;
    rdfs:label "external source"@en ;
    rdfs:domain rdf:Statement ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range xsd:string .

cleets:generatedByRule a owl:ObjectProperty ;
    rdfs:label "generated by rule"@en ;
    rdfs:domain cleets:CommonsenseInference ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range cleets:Rule .

cleets:hasAdoptionState a owl:ObjectProperty ;
    rdfs:label "has adoption state"@en ;
    rdfs:domain cleets:GeographicArea ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range cleets:AdoptionState .

cleets:hasChargingProvisionState a owl:ObjectProperty ;
    rdfs:label "has charging provision state"@en ;
    rdfs:domain cleets:GeographicArea ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range cleets:ChargingProvisionState .

cleets:hasInference a owl:ObjectProperty ;
    rdfs:label "has inference"@en ;
    rdfs:domain cleets:GeographicArea ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range cleets:CommonsenseInference .

cleets:hasProperty a owl:ObjectProperty ;
    rdfs:label "has property"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:hasSocialVulnerabilityState a owl:ObjectProperty ;
    rdfs:label "has social vulnerability state"@en ;
    rdfs:domain cleets:GeographicArea ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range cleets:SocialVulnerabilityState .

cleets:inferenceConclusion a owl:ObjectProperty ;
    rdfs:label "inference conclusion"@en ;
    rdfs:domain cleets:CommonsenseInference ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range cleets:ContextualState .

cleets:justification a owl:DatatypeProperty ;
    rdfs:label "justification"@en ;
    rdfs:domain cleets:CommonsenseInference ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range xsd:string .

cleets:lexicalisation a owl:DatatypeProperty ;
    rdfs:label "lexicalisation"@en ;
    rdfs:domain rdf:Statement ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range xsd:string .

cleets:localConcept a owl:ObjectProperty ;
    rdfs:label "local concept"@en ;
    rdfs:domain cleets:SemanticAlignment ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range owl:Thing .

cleets:mappingRelation a owl:ObjectProperty ;
    rdfs:label "mapping relation"@en ;
    rdfs:domain cleets:SemanticAlignment ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:range rdf:Property .

cleets:mayDecrease a owl:ObjectProperty ;
    rdfs:label "may decrease"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:partOf a owl:ObjectProperty ;
    rdfs:label "part of"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:relatedTo a owl:ObjectProperty ;
    rdfs:label "related to"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

<https://w3id.org/def/cleets/commonsense/statement/100ec59facf73dc97d0d> a rdf:Statement ;
    rdf:object cleets:ElectricVehicle ;
    rdf:predicate cleets:supports ;
    rdf:subject cleets:ChargingStation ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Charging stations support EV use."@en .

<https://w3id.org/def/cleets/commonsense/statement/12679f98272ea70bfcb2> a rdf:Statement ;
    rdf:object cleets:ChargingDemand ;
    rdf:predicate cleets:mayIncrease ;
    rdf:subject cleets:HighEVAdoption ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Higher EV adoption may increase charging demand."@en .

<https://w3id.org/def/cleets/commonsense/statement/3eb2515326b98484021e> a rdf:Statement ;
    rdf:object cleets:Battery ;
    rdf:predicate cleets:requires ;
    rdf:subject cleets:ElectricVehicle ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Battery-electric vehicles require a battery."@en .

<https://w3id.org/def/cleets/commonsense/statement/4aa9205edeaeee72d3aa> a rdf:Statement ;
    rdf:object cleets:ChargingDifficulty ;
    rdf:predicate cleets:mayCause ;
    rdf:subject cleets:ChargingUndersupply ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Charging undersupply may cause charging difficulty."@en .

<https://w3id.org/def/cleets/commonsense/statement/68873f086fe97cb73899> a rdf:Statement ;
    rdf:object cleets:Infrastructure ;
    rdf:predicate cleets:isA ;
    rdf:subject cleets:ChargingStation ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Charging stations are infrastructure."@en .

<https://w3id.org/def/cleets/commonsense/statement/78fc8034cd39761e6bbd> a rdf:Statement ;
    rdf:object cleets:Transportation ;
    rdf:predicate cleets:usedFor ;
    rdf:subject cleets:ElectricVehicle ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Electric vehicles are used for transportation."@en .

<https://w3id.org/def/cleets/commonsense/statement/85b2d1d51fcd2fdce794> a rdf:Statement ;
    rdf:object cleets:Vehicle ;
    rdf:predicate cleets:isA ;
    rdf:subject cleets:ElectricVehicle ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Electric vehicles are vehicles."@en .

<https://w3id.org/def/cleets/commonsense/statement/8c1ba19dbf7e02404719> a rdf:Statement ;
    rdf:object cleets:ChargingAccess ;
    rdf:predicate cleets:requires ;
    rdf:subject cleets:ElectricVehicle ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Electric vehicles generally require charging access."@en .

<https://w3id.org/def/cleets/commonsense/statement/c3b5ac191d616cd13835> a rdf:Statement ;
    rdf:object cleets:Electricity ;
    rdf:predicate cleets:requires ;
    rdf:subject cleets:ElectricVehicle ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Electric vehicles require electricity."@en .

<https://w3id.org/def/cleets/commonsense/statement/d3cc11ad4b5a5bc813b3> a rdf:Statement ;
    rdf:object cleets:Charging ;
    rdf:predicate cleets:usedFor ;
    rdf:subject cleets:ChargingStation ;
    prov:wasDerivedFrom cleetscs:curated-domain-knowledge-v1 ;
    cleets:lexicalisation "Charging stations are used for charging."@en .

cleets:ChargingUndersupply a owl:Class ;
    rdfs:label "Charging undersupply"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf cleets:ChargingProvisionState ;
    cleets:mayCause cleets:ChargingDifficulty .

cleets:HighEVAdoption a owl:Class ;
    rdfs:label "High EV adoption"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf cleets:AdoptionState ;
    cleets:mayIncrease cleets:ChargingDemand .

cleets:Rule a owl:Class ;
    rdfs:label "Reasoning rule"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf prov:Plan .

cleets:mayCause a owl:ObjectProperty ;
    rdfs:label "may cause"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:mayIncrease a owl:ObjectProperty ;
    rdfs:label "may increase"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:supports a owl:ObjectProperty ;
    rdfs:label "supports"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:SocialVulnerabilityState a owl:Class ;
    rdfs:label "Social vulnerability state"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf cleets:ContextualState .

cleets:isA a owl:ObjectProperty ;
    rdfs:label "is a"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:usedFor a owl:ObjectProperty ;
    rdfs:label "used for"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:ChargingProvisionState a owl:Class ;
    rdfs:label "Charging provision state"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf cleets:ContextualState .

cleets:ChargingStation cleets:isA cleets:Infrastructure ;
    cleets:supports cleets:ElectricVehicle ;
    cleets:usedFor cleets:Charging .

cleets:SemanticAlignment a owl:Class ;
    rdfs:label "Semantic alignment"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf prov:Entity .

cleets:requires a owl:ObjectProperty ;
    rdfs:label "requires"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:AdoptionState a owl:Class ;
    rdfs:label "Adoption state"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf cleets:ContextualState .

cleets:ContextualState a owl:Class ;
    rdfs:label "Contextual state"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> .

cleets:CommonsenseInference a owl:Class ;
    rdfs:label "Commonsense inference"@en ;
    rdfs:isDefinedBy <https://w3id.org/def/cleets/commonsense> ;
    rdfs:subClassOf prov:Entity .

cleets:ElectricVehicle cleets:isA cleets:Vehicle ;
    cleets:requires cleets:Battery,
        cleets:ChargingAccess,
        cleets:Electricity ;
    cleets:usedFor cleets:Transportation .

cleetscs:curated-domain-knowledge-v1 a prov:Entity .

<https://w3id.org/def/cleets/commonsense> a owl:Ontology ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:title "CLEETS Commonsense Ontology"@en .

